-- =========================================================
-- TOGGLE CREATOR
-- =========================================================

local function createToggle(name, y, callback)
    local button = Instance.new("TextButton")

    button.Size = UDim2.new(1, -20, 0, 38)
    button.Position = UDim2.fromOffset(10, y)
    button.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
    button.TextColor3 = Color3.fromRGB(200, 200, 220)
    button.TextSize = 12
    button.Font = Enum.Font.GothamSemibold
    button.Text = name .. ": [OFF]"
    button.Parent = MainFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = button

    local enabled = false

    button.Activated:Connect(function()
        enabled = not enabled

        if enabled then
            button.BackgroundColor3 = Color3.fromRGB(0, 180, 90)
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
            button.Text = name .. ": [ON]"
        else
            button.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
            button.TextColor3 = Color3.fromRGB(200, 200, 220)
            button.Text = name .. ": [OFF]"
        end

        callback(enabled)
    end)

    return button
end

-- =========================================================
-- NPC CACHE
-- =========================================================

local activeNPCs = {}
local npcConnections = {}

local function isPlayerCharacter(model)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character == model then
            return true
        end
    end

    return false
end

local function removeNPC(model)
    activeNPCs[model] = nil

    local connections = npcConnections[model]

    if connections then
        for _, connection in ipairs(connections) do
            if connection.Connected then
                connection:Disconnect()
            end
        end

        npcConnections[model] = nil
    end
end

local function registerNPC(model)
    if not model or not model:IsA("Model") then
        return
    end

    if activeNPCs[model] then
        return
    end

    if isPlayerCharacter(model) then
        return
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local head = model:FindFirstChild("Head")

    if not humanoid or not head then
        return
    end

    if humanoid.Health <= 0 then
        return
    end

    activeNPCs[model] = true
    npcConnections[model] = {}

    table.insert(
        npcConnections[model],
        humanoid.Died:Connect(function()
            removeNPC(model)
        end)
    )

    table.insert(
        npcConnections[model],
        model.AncestryChanged:Connect(function(_, parent)
            if parent == nil then
                removeNPC(model)
            end
        end)
    )
end

-- Initial scan
for _, obj in ipairs(workspace:GetDescendants()) do
    if obj:IsA("Model") then
        registerNPC(obj)
    end
end

-- New NPC / delayed components
workspace.DescendantAdded:Connect(function(obj)

    if obj:IsA("Model") then
        task.defer(function()
            registerNPC(obj)
        end)
    end

    local parent = obj.Parent

    if parent and parent:IsA("Model") then
        task.defer(function()
            registerNPC(parent)
        end)
    end
end)

workspace.DescendantRemoving:Connect(function(obj)
    if activeNPCs[obj] then
        removeNPC(obj)
    end
end)

-- =========================================================
-- ESP
-- =========================================================

local espFolder = Instance.new("Folder")
espFolder.Name = "NPC_ESP"
espFolder.Parent = ScreenGui

local espLabels = {}
local espEnabled = false

local function createESPLabel(index)
    if espLabels[index] then
        return espLabels[index]
    end

    local label = Instance.new("TextLabel")

    label.Size = UDim2.fromOffset(180, 42)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 200, 50)
    label.TextSize = 11
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0.2
    label.TextWrapped = true
    label.Visible = false
    label.Parent = espFolder

    espLabels[index] = label

    return label
end

local function hideAllESP()
    for _, label in ipairs(espLabels) do
        label.Visible = false
    end
end

createToggle("👁️ NPC ESP", 50, function(state)
    espEnabled = state

    if not state then
        hideAllESP()
    end
end)

local espTimer = 0

RunService.RenderStepped:Connect(function(dt)

    if not espEnabled then
        return
    end

    espTimer += dt

    if espTimer < CONFIG.ESP_UPDATE then
        return
    end

    espTimer = 0

    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local character = LocalPlayer.Character
    local localRoot = character and character:FindFirstChild("HumanoidRootPart")

    if not localRoot then
        hideAllESP()
        return
    end

    local index = 0

    for npc in pairs(activeNPCs) do

        if not npc.Parent then
            removeNPC(npc)
            continue
        end

        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        local head = npc:FindFirstChild("Head")
        local root =
            npc:FindFirstChild("HumanoidRootPart")
            or npc.PrimaryPart

        if not humanoid or humanoid.Health <= 0 or not head or not root then
            removeNPC(npc)
            continue
        end

        local distance =
            (localRoot.Position - root.Position).Magnitude

        if distance <= CONFIG.MAX_DISTANCE then

            local position, visible =
                camera:WorldToViewportPoint(
                    head.Position + Vector3.new(0, 1, 0)
                )

            if visible and position.Z > 0 then

                index += 1

                local label = createESPLabel(index)

                local text = npc.Name

                if CONFIG.SHOW_HEALTH then
                    text = text .. string.format(
                        "\nHP: %d/%d",
                        math.floor(humanoid.Health),
                        math.floor(humanoid.MaxHealth)
                    )
                end

                if CONFIG.SHOW_DISTANCE then
                    text = text .. string.format(
                        "  |  %dm",
                        math.floor(distance)
                    )
                end

                label.Text = text

                label.Position = UDim2.fromOffset(
                    position.X - 90,
                    position.Y
                )

                label.Visible = true
            end
        end
    end

    for i = index + 1, #espLabels do
        espLabels[i].Visible = false
    end
end)


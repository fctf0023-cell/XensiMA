TargetLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
TargetLabel.TextSize = 12
TargetLabel.Font = Enum.Font.GothamBold
TargetLabel.Text = "TARGET: NONE"
TargetLabel.Parent = MainFrame

local targetTimer = 0

RunService.RenderStepped:Connect(function(dt)

    if not targetEnabled then
        TargetLabel.Text = "TARGET: NONE"
        currentTarget = nil
        return
    end

    targetTimer += dt

    if targetTimer < 0.08 then
        return
    end

    targetTimer = 0

    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local viewport = camera.ViewportSize

    local center = Vector2.new(
        viewport.X / 2,
        viewport.Y / 2
    )

    local closest = nil
    local closestDistance = CONFIG.FOV_RADIUS

    for npc in pairs(activeNPCs) do

        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        local head = npc:FindFirstChild("Head")

        if humanoid and humanoid.Health > 0 and head then

            local position, visible =
                camera:WorldToViewportPoint(head.Position)

            if visible and position.Z > 0 then

                local distance =
                    (Vector2.new(position.X, position.Y) - center).Magnitude

                if distance <= closestDistance then
                    closestDistance = distance
                    closest = npc
                end
            end
        end
    end

    currentTarget = closest

    if currentTarget then
        TargetLabel.Text =
            "TARGET: " .. currentTarget.Name
    else
        TargetLabel.Text = "TARGET: NONE"
    end
end)

